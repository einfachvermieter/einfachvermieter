# Frontend Dev Port (Vite)
WEB_PORT=7272

# Frontend-Origin fuer CORS
WEB_ORIGIN=http://localhost:7272

# Wurzel fuer alle volatilen Daten: SQLite-DB, Uploads (Belege/Logo) und
# erstellte Abrechnungs-PDFs. Im Docker-Container auf /data gesetzt und als
# Volume gemountet. Default (wenn leer): ./data relativ zum Repo-Root.
DATA_DIR=./data

# Datenbank.
# - Default ohne weitere Angaben: SQLite unter ${DATA_DIR}/einfachvermieter.db.
# - DB_DRIVER erzwingt den Dialekt: sqlite | postgres | mysql (mariadb).
#   Ohne DB_DRIVER wird der Dialekt aus dem DATABASE_URL-Schema erkannt.
# - Fuer Postgres/MariaDB den Verbindungsstring in DATABASE_URL setzen:
#     DB_DRIVER=postgres
#     DATABASE_URL=postgres://user:pass@host:5432/einfachvermieter
#     DB_DRIVER=mysql
#     DATABASE_URL=mysql://user:pass@host:3306/einfachvermieter
# Fuer SQLite kann DATABASE_URL leer bleiben (DATA_DIR genuegt) oder einen
# expliziten Pfad enthalten:
DB_DRIVER=
DATABASE_URL=

# API Port (im Container auch per Port-Mapping verbiegbar)
PORT=7273

# Upload-Limits in MB (positive Ganzzahl). Autoritativ ist die API; ein
# vorgelagerter Reverse-Proxy muss ggf. dasselbe Limit erlauben.
# Belege/Anhänge (Default 20):
MAX_ATTACHMENT_MB=20
# Briefkopf-Logo (Default 2):
MAX_LOGO_MB=2

# Session-Lebensdauer in Tagen ab Anmeldung (Default 7).
SESSION_TTL_DAYS=7

# Passwort-Richtlinie (Admin-Konto + Passwort ändern). Default bewusst lasch,
# da lokal gehostet / Electron. Greift im Einrichtungs-Assistenten, beim
# Passwort-Ändern und in der bootstrap-admin-CLI.
# Mindestlänge (Default 8):
PASSWORD_MIN_LENGTH=8
# Zeichenklassen erzwingen (true/false, Default false):
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_DIGIT=false
PASSWORD_REQUIRE_SPECIAL=false

# Optional. Wenn gesetzt, wird KI-gestütztes Vorausfüllen von Rechnungen aktiviert.
MISTRAL_API_KEY=

# Optional. Überschreibt den API-Endpoint (Proxy/Azure-Mistral/self-hosted).
# Default: https://api.mistral.ai/v1
MISTRAL_API_BASE=

# Optional. Default: mistral-medium-latest
MISTRAL_MODEL=

# Optional. Default: mistral-ocr-latest
MISTRAL_OCR_MODEL=

# Optional. Wenn "true", wird neben dem hochgeladenen Anhang in
# data/uploads eine Datei <uuid>.debug mit allen Mistral-Anfragen
# und -Antworten (OCR + Chat) als JSON abgelegt.
# ACHTUNG: Die Dumps enthalten den OCR-Volltext der Belege
# (personenbezogene Daten) im Klartext und werden nicht automatisch
# geloescht. NUR lokal in der Entwicklung aktivieren, NIEMALS in
# Produktion. Vorhandene *.debug-Dateien nach der Analyse loeschen.
MISTRAL_DEBUG=
