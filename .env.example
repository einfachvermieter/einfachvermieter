# Alle Variablen sind optional - ohne .env startet die App mit den unten
# gezeigten Defaults. Zum Aendern die passende Zeile einkommentieren.


# --- Netzwerk & Pfade --------------------------------------------------------

# Frontend Dev Port (Vite)
#WEB_PORT=7272

# API Port (im Container auch per Port-Mapping verbiegbar)
#PORT=7273

# Adresse, auf der die API lauscht. Default 0.0.0.0 (alle Interfaces).
# Fuer Zugriff von/auf diesen Rechner 127.0.0.1 setzen.
#HOST=0.0.0.0

# Frontend-Origin fuer CORS. Nur noetig, wenn das Web-Frontend nicht ueber den
# Vite-Proxy laeuft. In Produktion liefert die API das Web-Build selbst aus
# -> leer lassen.
#WEB_ORIGIN=http://localhost:7272

# Root fuer alle volatilen Daten: SQLite-DB, Uploads (Belege/Logo) und
# erstellte Abrechnungs-PDFs. Im Docker-Container auf /data gesetzt und als
# Volume gemountet. Default: ./data relativ zum Repo-Root.
#DATA_DIR=./data

# Ablage der Uploads (Belege/Logo). Default: ${DATA_DIR}/uploads.
# Relativer Pfad zaehlt ab Repo-Root, absoluter Pfad wird 1:1 uebernommen.
#UPLOADS_DIR=


# --- Datenbank ---------------------------------------------------------------

# Default ohne weitere Angaben: SQLite unter ${DATA_DIR}/einfachvermieter.db.
# DB_DRIVER erzwingt den Dialekt: sqlite | postgres | mysql (mariadb).
# Ohne DB_DRIVER wird der Dialekt aus dem DATABASE_URL-Schema erkannt.
# Fuer SQLite kann DATABASE_URL leer bleiben (DATA_DIR genuegt) oder einen
# expliziten Pfad enthalten. Fuer Postgres/MariaDB:
#DB_DRIVER=postgres
#DATABASE_URL=postgres://user:pass@host:5432/einfachvermieter
#DB_DRIVER=mysql
#DATABASE_URL=mysql://user:pass@host:3306/einfachvermieter


# --- Limits & Session --------------------------------------------------------

# Upload-Limits in MB (positive Ganzzahl). Autoritativ ist die API; ein
# vorgelagerter Reverse-Proxy muss ggf. dasselbe Limit erlauben.
# Belege/Anhaenge:
#MAX_ATTACHMENT_MB=20
# Briefkopf-Logo:
#MAX_LOGO_MB=2

# Session-Lebensdauer in Tagen ab Anmeldung.
#SESSION_TTL_DAYS=7


# --- Passwort-Richtlinie -----------------------------------------------------

# Gilt fuer Admin-Konto und Passwort-Aendern. Default bewusst lasch, da lokal
# gehostet / Electron. Greift im Einrichtungs-Assistenten, beim
# Passwort-Aendern und in der bootstrap-admin-CLI.
#PASSWORD_MIN_LENGTH=8
#PASSWORD_REQUIRE_UPPERCASE=false
#PASSWORD_REQUIRE_LOWERCASE=false
#PASSWORD_REQUIRE_DIGIT=false
#PASSWORD_REQUIRE_SPECIAL=false


# --- Internetzugriffe --------------------------------------------------------

# Versionspruefung (nach Einwilligung). Adresse der Versionsdatei.
#UPDATE_FEED_URL=https://api.einfachvermieter.de/version.json

# Anonyme Nutzungsstatistik Empfaenger.
#TELEMETRY_URL=https://api.einfachvermieter.de/v1/telemetry

# Verlinkte Datenschutzerklaerung
#PRIVACY_URL=https://einfachvermieter.de/datenschutz/


# --- KI-Unterstuetzung -------------------------------------------------------

# Diese Konfiguration kann auch in der UI unter
#  Einstellungen / KI-Anbieter
# erfolgen und ist der bevorzugte Weg.
# Einstellungen in der UI ueberschreiben diese Werte hier.
#
# Welcher Anbieter genutzt wird, solange in der UI keiner gewaehlt ist.
# Moegliche Anbieter: mistral | openai | anthropic | gemini | ollama
#AI_PROVIDER=

# Die API-Keys. Der Suffix ist der Anbieter-Name in Grossbuchstaben,
# so dass fuer alle Anbieter ein API-Key nebeneinander liegen kann und ein
# Wechsel nur ein Umstellen von AI_PROVIDER (oder ein Klick in der UI) ist.
# Ollama braucht keinen API-Key.
#AI_API_KEY_MISTRAL=
#AI_API_KEY_OPENAI=
#AI_API_KEY_ANTHROPIC=
#AI_API_KEY_GEMINI=

# Ebenfalls je Anbieter. Ohne Angabe: empfohlenes Modell bzw. Standardadresse
# des Anbieters. Beispiele:
#AI_MODEL_OPENAI=gpt-4o
#AI_BASE_URL_OLLAMA=http://localhost:11434/v1


# =============================================================================
# GEFAHRENZONE
#
# Diese Variablen haengen die Anmeldung aus, legen Zugangsdaten oder
# personenbezogene Daten im Klartext ab oder schwaechen den Schutz der
# Session. Nur bewusst und nur so lange setzen, wie sie gebraucht werden -
# danach wieder auskommentieren und die App neu starten.
# =============================================================================

# Ersten Admin-User per CLI anlegen `node packages/db/dist/cli.js bootstrap-admin`.
# Nur fuer diesen Aufruf setzen, nicht dauerhaft in der .env lassen!
#ADMIN_EMAIL=
#ADMIN_PASSWORD=

# Passwort vergessen: einen selbst gewaehlten Code eintragen und die App neu
# starten. Sie zeigt dann nur noch das Formular "Passwort zuruecksetzen"
# (Konto waehlen, diesen Code eingeben, neues Passwort setzen). Solange der
# Wert gesetzt ist, bleibt die App gesperrt: danach die Variable wieder
# auskommentieren und erneut neu starten. Pro Start ist ein Zuruecksetzen
# moeglich.
#PASSWORD_RESET=

# Anzahl vertrauenswuerdiger Reverse-Proxy-Hops vor der API (Express
# "trust proxy"). Default 0: X-Forwarded-For/-Proto werden ignoriert. Hinter
# einem Proxy (nginx-proxy-manager, Caddy, Traefik ...) auf 1 setzen, damit
# das Rate-Limiting die echte Client-IP sieht und das Session-Cookie hinter
# TLS automatisch Secure wird. Ohne Proxy NICHT setzen, sonst kann jeder
# Client seine IP per Header selbst bestimmen.
#TRUST_PROXY=1

# Secure-Flag des Session-Cookies. Ohne Angabe folgt es der Verbindung,
# d.h. Secure bei HTTPS (direkt oder via Proxy mit TRUST_PROXY), sonst nicht.
# true erzwingt Secure (Login geht dann nur noch ueber HTTPS), false schaltet
# es ab und gibt das Cookie damit auch ueber unverschluesselte Verbindungen
# preis.
#COOKIE_SECURE=

# Wenn "true", wird neben dem hochgeladenen Anhang in data/uploads eine Datei
# <uuid>.debug mit allen KI-Anfragen und -Antworten (Texterkennung +
# Extraktion) als JSON abgelegt.
# ACHTUNG: Die Dumps enthalten den Volltext der Belege (personenbezogene
# Daten) im Klartext und werden nicht automatisch geloescht. NUR lokal in der
# Entwicklung aktivieren, NIEMALS in Produktion. Vorhandene *.debug-Dateien
# nach der Analyse loeschen.
#AI_DEBUG=true

# Desktop-App (Electron). Diese Variablen setzt der Electron-Hauptprozess
# selbst, wenn er die API startet. Manuell NICHT setzen!
# - AUTH_MODE=local: kein Login, stattdessen lokaler Admin-User; erfordert
#   LOOPBACK_TOKEN (vom Hauptprozess erzeugtes Geheimnis, das der Renderer
#   bei jeder Anfrage mitschickt). Ohne dieses Token ist eine so gestartete
#   API fuer jeden Prozess auf dem Rechner offen.
# - WEB_DIST_PATH: Pfad zum Web-Build, das die API ausliefert
#   (Default: apps/web/dist relativ zum Arbeitsverzeichnis).
# - APP_PLATFORM: Schluessel des Builds in der Versionsdatei, Form
#   <system>-<weg> (aktuell macos-download | win-store). Beim Bauen der
#   Pakete eingebrannt, Container-Images lassen ihn leer (= server).
#AUTH_MODE=local
#LOOPBACK_TOKEN=
#WEB_DIST_PATH=
#APP_PLATFORM=
