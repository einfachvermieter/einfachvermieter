# Frontend Dev Port (Vite)
WEB_PORT=7272

# Frontend-Origin fuer CORS
WEB_ORIGIN=http://localhost:7272

# Wurzel fuer alle volatilen Daten: SQLite-DB, Uploads (Belege/Logo) und
# erstellte Abrechnungs-PDFs. Im Docker-Container auf /data gesetzt und als
# Volume gemountet. Default (wenn leer): ./data relativ zum Repo-Root.
DATA_DIR=./data

# Datenbank.
# - Default ohne weitere Angaben: SQLite unter ${DATA_DIR}/einfachvermieter.db.
# - DB_DRIVER erzwingt den Dialekt: sqlite | postgres | mysql (mariadb).
#   Ohne DB_DRIVER wird der Dialekt aus dem DATABASE_URL-Schema erkannt.
# - Fuer Postgres/MariaDB den Verbindungsstring in DATABASE_URL setzen:
#     DB_DRIVER=postgres
#     DATABASE_URL=postgres://user:pass@host:5432/einfachvermieter
#     DB_DRIVER=mysql
#     DATABASE_URL=mysql://user:pass@host:3306/einfachvermieter
# Fuer SQLite kann DATABASE_URL leer bleiben (DATA_DIR genuegt) oder einen
# expliziten Pfad enthalten:
DB_DRIVER=
DATABASE_URL=

# API Port (im Container auch per Port-Mapping verbiegbar)
PORT=7273

# Upload-Limits in MB (positive Ganzzahl). Autoritativ ist die API; ein
# vorgelagerter Reverse-Proxy muss ggf. dasselbe Limit erlauben.
# Belege/Anhänge (Default 20):
MAX_ATTACHMENT_MB=20
# Briefkopf-Logo (Default 2):
MAX_LOGO_MB=2

# Session-Lebensdauer in Tagen ab Anmeldung (Default 7).
SESSION_TTL_DAYS=7

# Anzahl vertrauenswuerdiger Reverse-Proxy-Hops vor der API (Express
# "trust proxy"). Default 0: X-Forwarded-For wird ignoriert. Hinter einem
# Proxy (z. B. Compose-Caddy) auf 1 setzen, damit das Rate-Limiting die
# echte Client-IP sieht. Ohne Proxy NICHT setzen, sonst kann jeder Client
# seine IP per Header selbst bestimmen.
TRUST_PROXY=

# Passwort-Richtlinie (Admin-Konto + Passwort ändern). Default bewusst lasch,
# da lokal gehostet / Electron. Greift im Einrichtungs-Assistenten, beim
# Passwort-Ändern und in der bootstrap-admin-CLI.
# Mindestlänge (Default 8):
PASSWORD_MIN_LENGTH=8
# Zeichenklassen erzwingen (true/false, Default false):
PASSWORD_REQUIRE_UPPERCASE=false
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_DIGIT=false
PASSWORD_REQUIRE_SPECIAL=false

# Versionsprüfung (nach Einwilligung). Adresse der Versionsdatei;
# leer = https://api.einfachvermieter.de/version.json
UPDATE_FEED_URL=

# Anonyme Nutzungsstatistik Empfänger;
# leer = https://api.einfachvermieter.de/v1/telemetry
TELEMETRY_URL=

# KI-Untersützung
#
# Diese Konfiguration kann auch in der UI unter
#  Einstellungen / KI-Anbieter
# erfolgen und ist der bevorzugte Weg.
# Einstellungen in der UI überschreiben diese Werte hier.
#
# Welcher Anbieter genutzt wird, solange in der UI keiner gewählt ist.
# Mögliche Anbieter: mistral | openai | anthropic | gemini | ollama
AI_PROVIDER=

# Die API-Keys. Der Suffix ist der Anbieter-Name in Großbuchstaben,
# so dass für alle Anbieter ein API-Key nebeneinander liegen kann und ein
# Wechsel nur ein Umstellen von AI_PROVIDER (oder ein Klick in der UI) ist.
# Ollama braucht keinen API-Key.
AI_API_KEY_MISTRAL=
AI_API_KEY_OPENAI=
AI_API_KEY_ANTHROPIC=
AI_API_KEY_GEMINI=

# Optional, ebenfalls je Anbieter. Leer = empfohlenes Modell bzw.
# Standardadresse des Anbieters. Beispiele:
#   AI_MODEL_OPENAI=gpt-4o
#   AI_BASE_URL_OLLAMA=http://localhost:11434/v1

# Optional. Wenn "true", wird neben dem hochgeladenen Anhang in
# data/uploads eine Datei <uuid>.debug mit allen KI-Anfragen und
# -Antworten (Texterkennung + Extraktion) als JSON abgelegt.
# ACHTUNG: Die Dumps enthalten den Volltext der Belege
# (personenbezogene Daten) im Klartext und werden nicht automatisch
# gelöscht. NUR lokal in der Entwicklung aktivieren, NIEMALS in
# Produktion. Vorhandene *.debug-Dateien nach der Analyse löschen.
AI_DEBUG=
