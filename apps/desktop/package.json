{
  "name": "@einfachvermieter/desktop",
  "version": "2026.1.0-beta.1",
  "private": true,
  "license": "FSL-1.1-MIT",
  "description": "EinfachVermieter Desktop-App (Electron)",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "start": "electron .",
    "stage": "node scripts/stage.mjs",
    "dist": "npm run stage && electron-builder",
    "dist:mac": "npm run stage && electron-builder --mac",
    "dist:win": "npm run stage && electron-builder --win"
  },
  "devDependencies": {
    "@einfachvermieter/i18n": "*",
    "@types/node": "^24.12.0",
    "electron": "44.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.5",
    "typescript": "^6.0.2"
  }
}
